@LIT_SITE_CFG_IN_HEADER@

# Tool-specific config options.
config.name_suffix = "@CHERISEED_TEST_CONFIG_SUFFIX@"
config.target_cflags = "@CHERISEED_TEST_TARGET_CFLAGS@"
config.target_arch = "@CHERISEED_TEST_TARGET_ARCH@"
config.llvm_libs_dir = "@LLVM_LIBS_DIR@"

# Load common config for all compiler-rt lit tests.
lit_config.load_config(config, "@COMPILER_RT_BINARY_DIR@/test/lit.common.configured")

# Load tool-specific config that would do the real work.
lit_config.load_config(config, "@CHERISEED_LIT_TESTS_DIR@/lit.cfg.py")
