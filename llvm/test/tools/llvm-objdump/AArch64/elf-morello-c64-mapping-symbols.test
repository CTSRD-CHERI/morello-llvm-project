# RUN: llvm-mc -filetype=obj -triple=aarch64-unknown-freebsd -mattr=+morello %s | \
# RUN:   llvm-objdump --mattr=+morello -d - | FileCheck  %s

# RUN: llvm-mc -filetype=obj -triple=aarch64-unknown-freebsd -target-abi purecap %s | \
# RUN: llvm-objdump -d - | FileCheck  %s

  .section test, "xa"
  .align 8
 
  .global main
main:
  .arch armv8-a+a64c
  str c2,[x0, #0]
  stur c2,[c0, #0]
  str x2,[x0, #0]
  stur x2,[c0, #0]
  stp c0,c1,[x0, #0]
  adrp x0, #4294963200
 
  .arch armv8-a+c64
  stur c2,[x0, #0]
  str c2,[c0, #0]
  stur x2,[x0, #0]
  str x2,[c0, #0]
  stp c0,c1,[c0, #0]
  adrdp c0, #0

  .arch armv8-a+a64c
  str c2,[x0, #0]
  stur c2,[c0, #0]
  str x2,[x0, #0]
  stur x2,[c0, #0]
  stp c0,c1,[x0, #0]
  adrp x0, #4294963200

# CHECK: Disassembly of section test:
# CHECK: <main>:
# CHECK:       0: c2000002                  	str	c2, [x0, #0]
# CHECK:       4: e2800c02                  	stur	c2, [c0, #0]
# CHECK:       8: f9000002                  	str	x2, [x0]
# CHECK:       c: e2c00002                  	stur	x2, [c0, #0]
# CHECK:      10: 42800400                  	stp	c0, c1, [x0, #0]
# CHECK:      14: f07fffe0                  	adrp	x0, 0xfffff000
# CHECK: <$c.1>:
# CHECK:      18: e2800c02                  	stur	c2, [x0, #0]
# CHECK:      1c: c2000002                  	str	c2, [c0, #0]
# CHECK:      20: e2c00002                  	stur	x2, [x0, #0]
# CHECK:      24: f9000002                  	str	x2, [c0]
# CHECK:      28: 42800400                  	stp	c0, c1, [c0, #0]
# CHECK:      2c: 90000000                  	adrdp	c0, 0x0
# CHECK: <$x.2>:
# CHECK:      30: c2000002                  	str	c2, [x0, #0]
# CHECK:      34: e2800c02                  	stur	c2, [c0, #0]
# CHECK:      38: f9000002                  	str	x2, [x0]
# CHECK:      3c: e2c00002                  	stur	x2, [c0, #0]
# CHECK:      40: 42800400                  	stp	c0, c1, [x0, #0]
# CHECK:      44: f07fffe0                  	adrp	x0, 0xfffff000
